{
  "name": "tcg-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:packaging && npm run build",
    "postinstall": "npm run prepare:assets",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "build:index": "node --import tsx scripts/build-index.mjs",
    "benchmark:vision": "node --import tsx scripts/benchmark-vision.ts",
    "evaluate:photos": "node --import tsx scripts/evaluate-photos.ts",
    "prepare:assets": "node scripts/prepare-ocr.mjs && node scripts/prepare-vision-models.mjs",
    "build:learned-index": "node --import tsx scripts/build-learned-index.mjs",
    "test:packaging": "node --test scripts/stage-static-reference-data.test.mjs scripts/ocr-runtime-assets.test.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
